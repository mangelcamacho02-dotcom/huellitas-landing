# Copia este archivo como .env SOLO en local. Nunca subas valores reales.
# En Railway: referencia a la variable del servicio Postgres -> ${{Postgres.DATABASE_URL}}
# Si se deja vacía, la app usa SQLite local (leads.db).
DATABASE_URL=
# Cadena aleatoria larga: el MCP queda en /mcp-<MCP_PATH_SECRET>/
MCP_PATH_SECRET=
# true (por defecto) = carga leads ficticios al arrancar si la tabla está vacía
AUTO_SEED=true
# Opcional: URL pública de la landing, la devuelve el MCP para usarla en los posts
PUBLIC_URL=
